module

public import Mathlib
public import EventualAffineTraceResidue

/-!
# Eventual affine trace residue in shifted numerical semigroups: proofs of the statements of record

The definitions and statements of `Challenge.lean`, restated verbatim and proved. This module does not
import `Challenge`; the comparator checks that the statements and the definitions they use agree with
`Challenge.lean`. Restate the definitions of `Challenge.lean` above the theorems.
-/

@[expose] public section

namespace EventualAffineTraceResidue

/-- Eventual affine trace residue (PROOF.md §7, Theorem; answers CLAIM.md affirmatively). Let k ≥ 2 and let r : Fin (k + 1) → ℤ be offsets 0 = r_0 < r_1 < ... < r_k = w (hypotheses `r 0 = 0`, `StrictMono r`, `r (Fin.last k) = w`). Let d = gcd(r_1, ..., r_k), written `Finset.univ.gcd fun i : Fin k => r i.succ` (the nonnegative gcd in ℤ), and let n > 0 be an integer with gcd(n, d) = 1. For an integer λ let H_λ = `shiftedSemigroup k r n w λ`, the submonoid of ℤ generated by n + λw + r_i for 0 ≤ i ≤ k. Then there are integers A ≥ 0, B and L ≥ 0 such that for every integer λ ≥ L the trace residue res(H_λ) = |H_λ \ tr(H_λ)| (`traceResidue`, an extended natural number) is a finite number N with N = Aλ + B. -/
theorem trace_residue_eventually_affine (k : ℕ) (hk : 2 ≤ k) (r : Fin (k + 1) → ℤ) (w n : ℤ) (hr0 : r 0 = 0) (hr : StrictMono r) (hw : r (Fin.last k) = w) (hn : 0 < n) (hnd : Int.gcd n (Finset.univ.gcd fun i : Fin k => r i.succ) = 1) : ∃ A B L : ℤ, 0 ≤ A ∧ 0 ≤ L ∧ ∀ l : ℤ, L ≤ l → ∃ N : ℕ, traceResidue (shiftedSemigroup k r n w l : Set ℤ) = N ∧ (N : ℤ) = A * l + B :=
  trace_residue_eventually_affine_dev k hk r w n hr0 hr hw hn hnd

end EventualAffineTraceResidue
